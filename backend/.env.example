# App
APP_NAME=AgroSphere
APP_VERSION=1.0.0
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Gemini (required for AI explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ML paths (relative to backend/ when running locally)
ML_ARTIFACTS_PATH=../ml/artifacts
ML_SOURCE_PATH=../ml

# Postgres (host port 5433 → container 5432 when using docker compose db)
DATABASE_URL=postgresql+psycopg://agrosphere:agrosphere@localhost:5433/agrosphere

# JWT — generate strong secrets for production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-access-secret-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-use-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

# Schema changes: from backend/ run  alembic revision --autogenerate -m "msg"
# then  alembic upgrade head  (also runs automatically on API startup)
